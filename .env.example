AWS_REGION=ap-south-1
AWS_PROFILE=

S3_DEFAULT_BUCKET=
S3_MAX_READ_BYTES=1048576

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=
PG_SSLMODE=require
PG_USE_IAM_AUTH=false
PG_MAX_ROWS=500
PG_STATEMENT_TIMEOUT_MS=15000

ALLOW_WRITES=false
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
LOG_LEVEL=INFO